+++ b/csrc/libtorch_stable/moe/topk_softplus_sqrt_kernels.cu
@@ -0,0 +1,1022 @@
+/*
+ * Adapted from
+ * https://github.com/NVIDIA/TensorRT-LLM/blob/v0.7.1/cpp/tensorrt_llm/kernels/mixtureOfExperts/moe_kernels.cu
