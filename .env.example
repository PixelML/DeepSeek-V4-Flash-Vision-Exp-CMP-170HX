# Copy to .env, fill in your local paths and topology, then source it before
# running a script in scripts/. Do not commit .env.

# Exact local checkpoint path. Point this at a verified snapshot of
# deepseek-ai/DeepSeek-V4-Flash-Vision-Exp at the pinned revision.
WEIGHTS_PATH=/path/to/deepseek-v4-flash-vision-exp/deepseek-ai-86f746b36186f0e567729a5c06a8c918caba82a9
MODEL_REVISION=86f746b36186f0e567729a5c06a8c918caba82a9

# Four-card CMP 170HX node. Use an explicit device list, not "all" — see
# docs/TROUBLESHOOTING.md for why "all" can bind zero devices after a crash.
DEVICE_LIST=0,1,2,3
VLLM_PP_LAYER_PARTITION=11,11,11,10

# Runtime images (see docs/DOCKER-IMAGE.md for digests and lineage).
TEXT_IMAGE=ghcr.io/pixelml/club-170hx:vllm-deepseek-v4-sm80-20260902
VISION_IMAGE=ghcr.io/pixelml/club-170hx:vllm-deepseek-v4-vision-sm80-20260902

# Ports (host side).
TEXT_PORT=18098
VISION_PORT=18099

# Served model id. Keep this as the public checkpoint name; do not rename it
# to an internal or host-specific string.
SERVED_MODEL_NAME=deepseek-v4-flash-vision-exp

# Context and batching. 262144 is the current pin for the vision launch path;
# the largest prompt verified end to end at that setting is 65,000 tokens
# (prefill only) — see README.md, "Limitations."
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=2048
MAX_NUM_SEQS=8

KV_CACHE_DTYPE=fp8

# DSpark speculative decoding draft depth. 6 is the only value measured
# stable on this checkpoint at this topology.
MTP_NUM_TOKENS=6

GPU_MEMORY_UTILIZATION=0.90

# Power cap in watts, per card. 180 is the standing default; 250 measured no
# throughput gain — see README.md, "Measured performance."
POWER_LIMIT_W=180
